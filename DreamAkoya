    <style>
        /* =====================================================================
        قسم الأنماط الأساسية (Base Styles)
        يحتوي على الأنماط العامة للجسم والخطوط لضمان تناسق التصميم.
        =====================================================================
        */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f0f2f5; /* لون خلفية رمادي فاتح لمظهر نظيف */
            color: #333; /* لون نص رمادي داكن لسهولة القراءة */
            scroll-behavior: smooth; /* تمرير سلس للروابط الداخلية */
            /* تفعيل التخزين المؤقت للمتصفح (Browser Caching) - ملاحظة: هذا يتم التحكم فيه بشكل أساسي من جانب الخادم */
            /* Cache-Control: max-age=31536000, public; */
        }

        /* =====================================================================
        قسم مؤشر تقدم التمرير (Scroll Progress Indicator)
        يُظهر شريط تقدم في أعلى الصفحة يعكس مدى تصفح المستخدم.
        =====================================================================
        */
        #scroll-progress {
            position: fixed;
            top: 0;
            left: 0;
            width: 0%;
            height: 5px;
            background: linear-gradient(to right, #007bff, #00c6ff); /* تدرج أزرق لشريط التقدم */
            z-index: 1000; /* يضمن ظهوره فوق العناصر الأخرى */
            transition: width 0.1s ease-out; /* انتقال سلس لتغييرات العرض */
        }

        /* =====================================================================
        قسم قسم البطل (Hero Section)
        القسم الرئيسي الجذاب في أعلى الصفحة، مع خلفية ديناميكية وتأثيرات بصرية.
        =====================================================================
        */
        .hero-section {
            background: linear-gradient(to right, #007bff, #00c6ff); /* تدرج أزرق حيوي */
            color: white; /* نص أبيض للتباين */
            padding: 6rem 1rem; /* حشوة كبيرة لتأثير بصري قوي */
            text-align: center;
            position: relative;
            overflow: hidden; /* إخفاء عناصر الخلفية المتجاوزة */
            border-bottom-left-radius: 50px; /* حواف دائرية لمظهر عصري */
            border-bottom-right-radius: 50px;
            background-size: cover; /* تغطية القسم بالكامل */
            background-position: center; /* توسيط الصورة */
            transition: background-image 1s ease-in-out; /* انتقال سلس لصورة الخلفية */
            /* تطبيق تأثير التمرير المنظر (Parallax Scrolling) على الخلفية */
            background-attachment: fixed;
        }

        /* تمت إزالة تأثير الجسيمات الخفيفة (فقاعات متلألئة) من خلفية قسم البطل بناءً على طلب المستخدم.
        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.4); 
            z-index: 0; 
            background-image:
                radial-gradient(circle at 10% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(255, 255, 255, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 40% 60%, rgba(255, 255, 255, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 90% 30%, rgba(255, 255, 255, 0.12) 0%, transparent 50%);
            background-size: 20px 20px, 30px 30px, 15px 15px, 25px 25px; 
            animation: moveParticles 15s linear infinite; 
        }

        @keyframes moveParticles {
            0% { background-position: 0% 0%, 0% 0%, 0% 0%, 0% 0%; }
            100% { background-position: 100% 100%, 100% 100%, 100% 100%, 100% 100%; }
        }
        */

        /* التأكد من أن محتوى قسم البطل يظهر فوق التراكب */
        .hero-content {
            position: relative;
            z-index: 1;
        }

        /* =====================================================================
        قسم مؤقت العد التنازلي (Countdown Timer)
        تصميم المؤقت لتعزيز الإلحاح والندرة.
        =====================================================================
        */
        .countdown-timer {
            @apply flex justify-center items-center gap-4 mt-8 mb-12 flex-wrap; /* flex-wrap لضمان الاستجابة على الشاشات الصغيرة */
        }
        .countdown-item {
            /* تعديل: تم التغيير إلى flex-row للمحتوى الأفقي داخل كل عنصر */
            @apply bg-white text-blue-700 p-4 rounded-lg shadow-xl flex flex-row items-baseline justify-center gap-2; /* إضافة gap-2 للمسافة بين الرقم والوحدة */
            min-width: 120px; /* زيادة الحد الأدنى للعرض لاستيعاب النص الأفقي */
            transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out; /* انتقال سلس للتمرير */
        }
        .countdown-item:hover {
            transform: translateY(-5px) scale(1.02); /* رفع وتكبير طفيف عند التمرير */
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15); /* ظل أكثر وضوحًا عند التمرير */
        }
        .countdown-value {
            @apply text-5xl md:text-6xl font-extrabold; /* زيادة حجم الخط للبروز */
        }
        .countdown-label {
            @apply text-base md:text-lg mt-0; /* زيادة حجم الخط، والتأكد من عدم وجود هامش علوي للتخطيط الأفقي */
        }

        /* =====================================================================
        قسم الأزرار (Buttons)
        أنماط الأزرار الأساسية والثانوية مع تأثيرات التفاعل.
        =====================================================================
        */
        /* نمط الزر الأساسي مع التدرج وتأثيرات التمرير */
        .btn-primary {
            @apply bg-gradient-to-r from-blue-500 to-purple-600 text-white font-bold py-3 px-8 rounded-full shadow-lg transition duration-300 ease-in-out transform;
            position: relative; /* مطلوب للعناصر الزائفة مثل التوهج */
            overflow: hidden; /* إخفاء التجاوز لتأثير التوهج */
            z-index: 1; /* التأكد من أن الزر فوق توهجه */
        }
        .btn-primary:hover {
            transform: scale(1.05) translateY(-2px); /* رفع وتكبير طفيف */
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3), 0 0 40px rgba(0, 123, 255, 0.7); /* ظل أقوى وتوهج أزرق */
        }
        /* الرسوم المتحركة النبضية لزر الدعوة الأساسي */
        .btn-primary.pulse-animation {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.7);
            }
            70% {
                box-shadow: 0 0 0 15px rgba(0, 123, 255, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(0, 123, 255, 0);
            }
        }

        /* نمط الزر الثانوي مع خلفية بيضاء وتأثيرات التمرير */
        .btn-secondary {
            @apply bg-white text-blue-600 font-bold py-3 px-8 rounded-full shadow-md hover:bg-gray-100 transition duration-300 ease-in-out transform hover:scale-105;
        }

        /* =====================================================================
        قسم البطاقات (Cards)
        أنماط البطاقات المستخدمة للميزات ومعلومات الاتصال.
        =====================================================================
        */
        .card {
            @apply bg-white rounded-xl shadow-lg p-6 flex flex-col items-center text-center transition duration-300 ease-in-out transform hover:scale-105 hover:shadow-xl; /* تأثير تمرير محسّن */
        }
        /* نمط الأيقونات داخل البطاقات - تم استبدال أيقونات Lucide برسومات توضيحية SVG مخصصة */
        .icon {
            @apply text-blue-500 mb-4;
            width: 48px; /* حجم الأيقونة */
            height: 48px; /* حجم الأيقونة */
        }

        /* =====================================================================
        قسم شريط التمرير المخصص (Custom Scrollbar)
        لتحسين المظهر وتجربة المستخدم.
        =====================================================================
        */
        ::-webkit-scrollbar {
            width: 8px; /* عرض شريط التمرير */
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; /* لون مسار شريط التمرير */
            border-radius: 10px; /* حواف دائرية للمسار */
        }
        ::-webkit-scrollbar-thumb {
            background: #888; /* لون مقبض شريط التمرير */
            border-radius: 10px; /* حواف دائرية للمقبض */
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #555; /* لون المقبض عند التمرير */
        }

        /* =====================================================================
        قسم الرسوم المتحركة للإدخال (Keyframe Animations for Entrance Effects)
        تأثيرات دخول خفية للعناصر عند ظهورها في العرض.
        =====================================================================
        */
        @keyframes fade-in-down {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-down {
            animation: fade-in-down 0.8s ease-out forwards;
        }

        @keyframes fade-in-up {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in-up {
            animation: fade-in-up 0.8s ease-out forwards;
        }

        @keyframes bounce-in {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); }
        }
        .animate-bounce-in {
            animation: bounce-in 0.8s ease-out forwards;
        }

        /* =====================================================================
        قسم زر الدعوة الثابت (Sticky CTA Button)
        تم إخفاء هذا الزر بناءً على طلب المستخدم.
        =====================================================================
        */
        .sticky-cta {
            display: none !important; /* إخفاء الزر بالقوة */
        }

        /* =====================================================================
        تحسينات إضافية على عناصر النموذج (Form Elements Enhancements)
        لتحسين التفاعل والملاحظات المرئية.
        =====================================================================
        */
        input[type="text"],
        input[type="tel"],
        input[type="number"] {
            transition: border-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
        }
        input[type="text"]:focus,
        input[type="tel"]:focus,
        input[type="number"]:focus {
            border-color: #007bff; /* لون الحدود عند التركيز */
            box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25); /* ظل خفيف عند التركيز */
            outline: none; /* إزالة التركيز الافتراضي للمتصفح */
        }
        /* نمط لرسائل الخطأ في النموذج */
        .error-message {
            color: #dc3545; /* لون أحمر للخطأ */
            font-size: 0.875rem;
            margin-top: 0.25rem;
            text-align: right;
        }
    </style>
