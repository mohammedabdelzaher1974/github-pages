    <script>
        // تهيئة أيقونات Lucide (تم إزالة استدعاء createIcons() حيث لم تعد المكتبة مستخدمة)
        // lucide.createIcons();

        // مصفوفة من عناوين URL للصور لخلفية قسم البطل (Hero Section) الدوارة
        // ملاحظة: لتحسين الأداء بشكل أكبر، يمكن تحويل هذه الصور إلى صيغ WebP/AVIF
        // واستخدامها مع عنصر <picture> لتوفير صيغ مختلفة للمتصفحات المختلفة.
        const heroImages = [
            'https://i.pinimg.com/736x/1e/16/cd/1e16cd64d47570b11b94a793290bb32c.jpg',
            'https://i.pinimg.com/736x/c5/76/b5/c576b5cc7a074dab28b56f482a8913eb.jpg',
            'https://i.pinimg.com/736x/02/3a/6f/023a6f21e30a0f2d1991ecceae1ff018.jpg',
            'https://i.pinimg.com/736x/41/5c/8f/415c8f62b40118a4b2add8f5cdeffb0a.jpg',
            'https://i.pinimg.com/736x/00/cd/0a/00cd0afee75b96b01e86af8c2627820d.jpg',
            'https://i.pinimg.com/736x/9d/e5/36/9de53622e0fa63a59ab18196a88519ab.jpg',
            'https://i.pinimg.com/736x/48/d2/3a/48d23a2b848ee10243b7348769c60672.jpg',
            'https://i.pinimg.com/736x/0e/45/6b/0e456b26623d2c41c804fa5d6be573ea.jpg',
            'https://i.pinimg.com/736x/1b/ee/38/1bee381895011d196403cf70f5fa265c.jpg',
            'https://i.pinimg.com/736x/66/2a/d8/662ad8a1beb52261cdfe8fb2b5d6acc0.jpg'
        ];

        let currentImageIndex = 0;
        const heroSection = document.querySelector('.hero-section');

        // التحميل المسبق للصور لمنع الوميض أثناء الانتقال
        const preloadImages = (urls) => {
            urls.forEach(url => {
                const img = new Image();
                img.src = url;
                // تفعيل التحميل الكسول (Lazy Loading) للصور غير المرئية في البداية
                img.loading = 'lazy'; 
            });
        };
        preloadImages(heroImages);

        // وظيفة لتغيير صورة الخلفية
        const changeHeroBackground = () => {
            currentImageIndex = (currentImageIndex + 1) % heroImages.length;
            heroSection.style.backgroundImage = `url('${heroImages[currentImageIndex]}')`;
        };

        // تعيين صورة الخلفية الأولية
        heroSection.style.backgroundImage = `url('${heroImages[currentImageIndex]}')`;

        // تعيين الفاصل الزمني لتغيير الصورة كل 3 ثوانٍ (3000 مللي ثانية)
        setInterval(changeHeroBackground, 3000);

        // منطق مؤقت العد التنازلي (عيد الأضحى 2025 - التاريخ المستهدف 8 يونيو 2025، 00:00:00 بتوقيت شرق أوروبا الصيفي)
        const eidDate = new Date('June 8, 2025 00:00:00 GMT+0300').getTime(); // EEST هو GMT+3

        const updateCountdown = () => {
            const now = new Date().getTime();
            const distance = eidDate - now;

            // حساب الأيام والساعات والدقائق والثواني المتبقية
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            // تحديث عناصر DOM بالقيم الجديدة، مع إضافة صفر بادئ إذا كانت القيمة أقل من 10
            document.getElementById('days').innerText = days < 10 ? '0' + days : days;
            document.getElementById('hours').innerText = hours < 10 ? '0' + hours : hours;
            document.getElementById('minutes').innerText = minutes < 10 ? '0' + minutes : minutes;
            document.getElementById('seconds').innerText = seconds < 10 ? '0' + seconds : seconds;

            // إذا انتهى العد التنازلي، عرض رسالة "انتهى العرض!"
            if (distance < 0) {
                clearInterval(countdownInterval);
                document.querySelector('.countdown-timer').innerHTML = '<span class="text-2xl font-bold">انتهى العرض!</span>';
            }
        };

        // تحديث العد التنازلي كل ثانية
        const countdownInterval = setInterval(updateCountdown, 1000);
        updateCountdown(); // استدعاء أولي لعرض العد التنازلي فورًا

        // منطق مؤشر تقدم التمرير
        const scrollProgress = document.getElementById('scroll-progress');
        window.addEventListener('scroll', () => {
            const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (scrollTop / scrollHeight) * 100;
            scrollProgress.style.width = scrolled + '%';
            scrollProgress.setAttribute('aria-valuenow', Math.round(scrolled));
        });

        // منطق زر الدعوة الثابت (تمت إزالته بناءً على طلب المستخدم)
        /*
        const stickyCtaButton = document.getElementById('sticky-cta-button');
        const heroSectionHeight = heroSection.offsetHeight;
        window.addEventListener('scroll', () => {
            if (window.scrollY > heroSectionHeight / 2) {
                stickyCtaButton.classList.add('show');
            } else {
                stickyCtaButton.classList.remove('show');
            }
        });
        */

        // Intersection Observer لتحريك العناصر عند ظهورها في العرض
        const animateOnScroll = (entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-in-up');
                    observer.unobserve(entry.target);
                }
            });
        };

        const observer = new IntersectionObserver(animateOnScroll, {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        });

        // مراقبة العناصر التي تحتوي على تأثيرات الدخول
        document.querySelectorAll('.card, .section-gradient, #why-dream-alex-heading, #booking-form-section').forEach(el => {
            observer.observe(el);
        });

        // التمرير السلس للروابط الداخلية
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

        // منطق إرسال نموذج الواتساب مع التحقق من صحة البيانات في الوقت الفعلي
        const bookingForm = document.getElementById('booking-form');
        const fullNameInput = document.getElementById('full-name');
        const phoneNumberInput = document.getElementById('phone-number');
        const numAdultsInput = document.getElementById('num-adults');
        const numChildrenInput = document.getElementById('num-children');

        // وظيفة لعرض رسالة خطأ
        const displayError = (element, message) => {
            const errorDiv = document.getElementById(element.id + '-error');
            if (errorDiv) {
                errorDiv.textContent = message;
            }
            element.classList.add('border-red-500'); // إضافة حدود حمراء للإشارة إلى الخطأ
        };

        // وظيفة لإخفاء رسالة الخطأ
        const hideError = (element) => {
            const errorDiv = document.getElementById(element.id + '-error');
            if (errorDiv) {
                errorDiv.textContent = '';
            }
            element.classList.remove('border-red-500'); // إزالة الحدود الحمراء
        };

        // التحقق من صحة الاسم الكامل
        fullNameInput.addEventListener('input', () => {
            if (fullNameInput.value.trim() === '') {
                displayError(fullNameInput, 'الاسم الكامل مطلوب.');
            } else {
                hideError(fullNameInput);
            }
        });

        // التحقق من صحة رقم الهاتف (مصري)
        phoneNumberInput.addEventListener('input', () => {
            const phonePattern = /^01[0-9]{9}$/;
            if (!phonePattern.test(phoneNumberInput.value)) {
                displayError(phoneNumberInput, 'يرجى إدخال رقم هاتف مصري صحيح (11 رقمًا يبدأ بـ 01).');
            } else {
                hideError(phoneNumberInput);
            }
        });

        // التحقق من صحة عدد البالغين
        numAdultsInput.addEventListener('input', () => {
            if (parseInt(numAdultsInput.value) < 1) {
                displayError(numAdultsInput, 'يجب أن يكون عدد البالغين واحدًا على الأقل.');
            } else {
                hideError(numAdultsInput);
            }
        });

        // التحقق من صحة عدد الأطفال
        numChildrenInput.addEventListener('input', () => {
            if (parseInt(numChildrenInput.value) < 0) {
                displayError(numChildrenInput, 'لا يمكن أن يكون عدد الأطفال أقل من صفر.');
            } else {
                hideError(numChildrenInput);
            }
        });


        bookingForm.addEventListener('submit', function(e) {
            e.preventDefault(); // منع الإرسال الافتراضي للنموذج

            // تشغيل التحقق من صحة جميع الحقول عند الإرسال
            let isValid = true;
            if (fullNameInput.value.trim() === '') {
                displayError(fullNameInput, 'الاسم الكامل مطلوب.');
                isValid = false;
            } else {
                hideError(fullNameInput);
            }

            const phonePattern = /^01[0-9]{9}$/;
            if (!phonePattern.test(phoneNumberInput.value)) {
                displayError(phoneNumberInput, 'يرجى إدخال رقم هاتف مصري صحيح (11 رقمًا يبدأ بـ 01).');
                isValid = false;
            } else {
                hideError(phoneNumberInput);
            }

            if (parseInt(numAdultsInput.value) < 1) {
                displayError(numAdultsInput, 'يجب أن يكون عدد البالغين واحدًا على الأقل.');
                isValid = false;
            } else {
                hideError(numAdultsInput);
            }

            if (parseInt(numChildrenInput.value) < 0) {
                displayError(numChildrenInput, 'لا يمكن أن يكون عدد الأطفال أقل من صفر.');
                isValid = false;
            } else {
                hideError(numChildrenInput);
            }

            if (!isValid) {
                // إذا كان هناك أي خطأ، توقف هنا ولا ترسل رسالة الواتساب
                return;
            }

            const fullName = fullNameInput.value;
            const phoneNumber = phoneNumberInput.value;
            const numAdults = numAdultsInput.value;
            const numChildren = numChildrenInput.value; 

            // إنشاء رسالة الواتساب بجميع البيانات المجمعة
            const message = `طلب حجز رحلة أكويا ووتر بارك:\n` +
                            `الاسم الكامل: ${fullName}\n` +
                            `رقم الهاتف: ${phoneNumber}\n` +
                            `عدد البالغين: ${numAdults}\n` +
                            `عدد الأطفال (أقل من 10 سنوات): ${numChildren}\n` +
                            `برجاء تأكيد الحجز.`;

            // ترميز الرسالة لعنوان URL
            const encodedMessage = encodeURIComponent(message);

            // رقم الواتساب المستهدف
            const whatsappNumber = '201000068220';

            // إنشاء رابط الواتساب
            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

            // فتح الواتساب في علامة تبويب جديدة
            window.open(whatsappUrl, '_blank');

            // اختياريًا، مسح النموذج بعد الإرسال الناجح
            bookingForm.reset();
        });

        // ملاحظة: يمكن دمج Google Analytics و A/B Testing Frameworks هنا
        // <script async src="https://www.googletagmanager.com/gtag/js?id=GA_MEASUREMENT_ID"></script>
